FROM node:22-bookworm-slim AS assets

WORKDIR /app
COPY package.json ./
RUN npm install --no-audit --no-fund
COPY . .
RUN npm run build

FROM php:8.3-cli-bookworm AS dependencies

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends libonig-dev libpq-dev libzip-dev unzip \
    && docker-php-ext-install bcmath mbstring pdo_pgsql zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist
COPY . .
COPY --from=assets /app/public/build ./public/build
RUN composer dump-autoload --no-dev --classmap-authoritative

FROM dunglas/frankenphp:1-php8.3-bookworm AS runtime

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions bcmath mbstring pdo_pgsql zip

WORKDIR /app
COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data docker/Caddyfile.vercel /etc/frankenphp/Caddyfile
COPY docker/start-vercel.sh /usr/local/bin/start-vercel

RUN chmod 0755 /usr/local/bin/start-vercel \
    && setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

ENV APP_ENV=production \
    APP_DEBUG=false \
    APP_TIMEZONE=Asia/Jakarta \
    ACCOUNT_MANAGEMENT_PASSWORD=pakdekuwat \
    DB_CONNECTION=pgsql \
    SESSION_DRIVER=database \
    SESSION_ENCRYPT=true \
    SESSION_SECURE_COOKIE=true \
    CACHE_STORE=database \
    QUEUE_CONNECTION=sync \
    LOG_CHANNEL=stderr \
    LARAVEL_STORAGE_PATH=/tmp/storage \
    PORT=80

USER www-data

EXPOSE 80

CMD ["start-vercel"]
